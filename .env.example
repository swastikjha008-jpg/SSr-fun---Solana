# Copy to .env.local and fill in. NEVER commit real values.

# PostgreSQL connection string (use a pooled URL on serverless, e.g. Neon/Supabase pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ssrfun_companion?sslmode=require"

# The single private administrator. There is no public registration.
ADMIN_EMAIL="admin@example.com"

# bcrypt hash of the admin password. Generate with:  pnpm hash-password
# In a local .env file escape each "$" as "\$" (the script prints that form).
# In Vercel's dashboard paste the raw hash with no escaping.
ADMIN_PASSWORD_HASH="\$2a\$12\$sd6zVV3GUv0xlsVfnq80c.Ua4seUDPfiqMmuIMav1FQiQci59reQe"

# 32+ random characters, e.g.  openssl rand -base64 48
SESSION_SECRET="GENERATE_WITH_openssl_rand_-base64_48"

# Read-only Solana RPC. Use a dedicated provider URL for production traffic.
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Public origin of the deployed app (used for CSRF/origin checks). No trailing slash. Must be https in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: hero ASCII background. Direct link to a short, looping, dark .mp4 and a poster image.
# Without them the hero renders a procedural ASCII field.
NEXT_PUBLIC_ASCII_VIDEO_URL=""
NEXT_PUBLIC_ASCII_POSTER_URL=""
